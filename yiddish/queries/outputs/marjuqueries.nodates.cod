			    (NP-SBJ (PRO men))
			    (MDF ken)
			    (NEG nit)
			    (VB barekhtikn)
			    (NP-ACC (D dem)
				    (N verb)
				    (PP (P oyf@)
					(NP (D @n) (ADJ fertn) (N ort))))
			    (PUNC ,)
			    (IP-SUB-PRN=2 (CODING-IP-SUB-PRN=2 z:z:z:xxxgenre:ppchy)
					  (CONJ un)
					  (ADVP-TMP (ADV oft_mol))
					  (ADVP (ADV oykh))
					  (NEG nit)
					  (PP (P oyf@)
					      (NP (D @n) (ADJ dritn))))
			    (PUNC ,)
			    (PP (P in)
				(NP (D der) (ADJ poetisher) (N shprakh)))))
	  (PUNC ,)
	  (VBF iz)
	  (NP-SBJ *exp*)
	  (PP (P el)
	      (NP (H akht^one) (H kmh^a_few) (H ukmh^and_a_few)))
	  (PP (PP (P in)
		  (NP (D der) (ADJ posheter) (N tseytung-notits)))
	      (CONJP (CONJ un)
		     (PP (P in)
			 (NP (D dem) (ADJ publitsistishn) (N artikl))))
	      (PUNC ,)
	      (CONJP (CONJ tsi)
		     (PP (P in)
			 (NP (D der) (ADJ visnshaftlekher) (N fraze)))))
	  (PUNC .))
  (ID 1946E-MARK,15.455))

