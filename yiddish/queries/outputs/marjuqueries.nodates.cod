/~*
liebe froyndin, du liebe kron, ikh kasven dir fil,
(1478W-LETTER-REGENSBURG,156.3)
*~/

( (IP-MAT (CODING-IP-MAT z:z:object:xxxgenre:ppchy)
	  (NP-VOC (ADJ liebe) (N froyndin))
	  (PUNC ,)
	  (NP-VOC (PRO du) (ADJ liebe) (N kron))
	  (PUNC ,)
	  (NP-SBJ (PRO ikh))
	  (VBF kasven)
	  (NP-DTV (PRO dir))
	  (CODE {TEXT:di})
	  (NP-MSR (Q fil))
	  (PUNC ,))
  (ID 1478W-LETTER-REGENSBURG,156.3))

